# Local Minecraft / caches (do not commit world data)
instance/
downloads/
backups/
vendor/
.venv/
**/__pycache__/
*.pyc
*.pyo
.DS_Store
.matplotlib-cache/

# Live builder lock (scripts/site_lock.py)
site/LOCK.json

# Large verification artefacts stay local unless deliberately committed
verification/site/**/*.png
verification/site/patrol/
verification/site/coverage/touched-cache.json

# Reference imagery / OSM clips are local (copyright / size)
reference/photos/**
reference/aerial/**
reference/osm/**
!reference/photos/.gitkeep
!reference/aerial/.gitkeep
!reference/osm/.gitkeep
reference/tpo/cache/**
!reference/tpo/.gitkeep
!reference/tpo/species-overrides.jsonl
!reference/README.txt
!reference/SOURCES.txt
!reference/LOGGING.txt
!reference/manifest.jsonl

# handoff stop-hook marker
site/.handoff-pending.json

# Per-build generated outputs (re-creatable by the build scripts)
verification/site/*-cells.json
verification/site/*-result.json
verification/site/*-backup.json
verification/site/*-clashes.json
verification/site/*-footprint-hits.json
verification/site/*-hits.json
verification/site/*-plan.json
verification/site/*-planned.json
verification/site/*-fingerprint.json
verification/site/*-removed.json
verification/site/*-ln.geojson
verification/site/plots-*.json
verification/site/osm27700/

# Stray imagery (local only, same policy as reference/photos)
reference/reference/
coffin-pillbox/
.claude/settings.local.json

# Lidar height maps (regenerable from the pristine save)
verification/site/lidar/
